NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OBI: shared server/updater cache on a persistent local volume. Default: work/obi-query-cache.json
# OBI_CACHE_PATH=C:/path/to/persistent/obi-query-cache.json
# Enable only after applying 202610040001_obi_verified_products.sql:
# OBI_USE_SUPABASE=true
# Optional normal OBI test market, only for the updater (never the customer's location):
# OBI_TEST_MARKET_URL=https://www.obi.de/markt/your-test-market
# OBI_BROWSER_STORAGE_STATE=work/obi-browser-session.json
# Chromium runs headless by default. No stealth/challenge bypass.
# OBI_BROWSER_HEADLESS=true

# Optional: own/contracted Nominatim and Overpass endpoints; see docs/OSM.md.
# OSM_NOMINATIM_URL=https://your-geocoder.example/
# OSM_OVERPASS_URL=https://your-overpass.example/api/interpreter
# OSM_USER_AGENT=Baumarktfinder/1.0 (your real operator contact)
